# Copy file này thành .env rồi điền giá trị phù hợp
# cp .env.example .env

# --- Cùng mạng WiFi (không có AP Isolation) ---
# Để trống, app tự detect IP từ Metro bundler
EXPO_PUBLIC_API_HOST=

# --- Khác mạng hoặc có AP Isolation ---
# Bước 1: cài cloudflared (1 lần)
#   winget install Cloudflare.cloudflared
#
# Bước 2: chạy tunnel cho backend (mỗi lần dev)
#   cloudflared tunnel --url http://localhost:5027
#
# Bước 3: copy URL hiện ra (dạng https://xxxx.trycloudflare.com) vào đây
# EXPO_PUBLIC_API_HOST=https://xxxx.trycloudflare.com
